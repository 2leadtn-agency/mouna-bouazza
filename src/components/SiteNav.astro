---
interface Props {
  lang: "fr" | "ar";
  altHref?: string;
}
const { lang, altHref } = Astro.props;
const isAr = lang === "ar";
const home = isAr ? "/ar/" : "/";
const switchHref = altHref ?? (isAr ? "/" : "/ar/");
const contactHref = isAr ? "/ar/#contact" : "/#contact";

const icon = (name: string) => {
  const icons: Record<string, string> = {
    menu: '<path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>',
    languages: '<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>',
  };
  return icons[name] ?? "";
};
---

<header class="site-nav" id="siteNav">
  <div class="container nav-inner">
    <a href={home} class={isAr ? "wordmark wordmark-ar" : "wordmark"}>
      {isAr ? "نور المنى بوعزة" : "Mouna Bouazza"}
    </a>

    <nav class="nav-links" id="navLinks">
      {isAr ? (
        <Fragment>
          <a href="/ar/">الرئيسية</a>
          <a href="/ar/a-propos/">من أنا</a>
          <a href="/ar/soins/">جلسات العناية</a>
          <a href="/ar/experience/">تجربتكِ</a>
          <a href="/ar/espace/">الفضاء</a>
        </Fragment>
      ) : (
        <Fragment>
          <a href="/espace/">L'espace</a>
          <a href="/soins/">Les soins</a>
          <a href="/experience/">L'expérience</a>
          <a href="/#contact">Contact</a>
        </Fragment>
      )}
      <a href={switchHref} class="lang-switch" hreflang={isAr ? "fr" : "ar"} lang={isAr ? "fr" : "ar"}>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("languages")} />
        {isAr ? "Français" : "العربية"}
      </a>
      <a href={contactHref} class="nav-cta">{isAr ? "احجزي موعدكِ" : "Prendre rendez-vous"}</a>
    </nav>

    <button class="nav-toggle" id="navToggle" aria-label={isAr ? "فتح القائمة" : "Ouvrir le menu"}>
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("menu")} />
    </button>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-block: 1.4rem;
    transition: background 0.4s var(--ease-soft), padding 0.4s var(--ease-soft), box-shadow 0.4s var(--ease-soft);
    animation: nav-drop-in 0.8s var(--ease-soft);
  }
  @keyframes nav-drop-in {
    from { opacity: 0; transform: translateY(-14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav { animation: none; }
  }
  .site-nav.scrolled {
    background: rgba(247, 241, 230, 0.92);
    backdrop-filter: blur(10px);
    padding-block: 0.85rem;
    box-shadow: 0 1px 0 rgba(53, 41, 31, 0.08);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .wordmark {
    font-family: "Fraunces", serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.5rem;
    text-decoration: none;
    color: var(--espresso);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .wordmark-ar {
    font-family: "Aref Ruqaa", serif;
    font-style: normal;
    font-weight: 700;
    font-size: 1.3rem;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .nav-links a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--espresso-soft);
    position: relative;
    padding-block: 0.2rem;
    white-space: nowrap;
  }
  .nav-links a:not(.nav-cta)::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--terracotta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-soft);
  }
  :global(html[dir="rtl"]) .nav-links a:not(.nav-cta)::after { transform-origin: right; }
  .nav-links a:not(.nav-cta):hover::after { transform: scaleX(1); }
  .nav-links a:not(.nav-cta):hover { color: var(--espresso); }
  .nav-cta {
    background: var(--terracotta);
    color: var(--paper) !important;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font-weight: 500;
    transition: background 0.35s ease, transform 0.35s var(--ease-soft);
  }
  .nav-cta:hover { background: var(--terracotta-dark); transform: translateY(-2px); }
  .nav-links .lang-switch { font-size: 0.82rem; }
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--espresso);
    width: 2.2rem; height: 2.2rem;
    cursor: pointer;
  }
  .nav-toggle .icon { width: 1.6rem; height: 1.6rem; }

  @media (max-width: 1080px) {
    .nav-toggle { display: flex; align-items: center; justify-content: center; }
    .nav-links {
      position: fixed;
      top: 0; right: 0;
      height: 100vh;
      width: min(78vw, 320px);
      background: var(--paper);
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 1.5rem;
      padding: 2rem 2.5rem;
      transform: translateX(100%);
      transition: transform 0.5s var(--ease-soft);
      box-shadow: -8px 0 30px rgba(53, 41, 31, 0.12);
    }
    :global(html[dir="rtl"]) .nav-links {
      right: auto; left: 0;
      transform: translateX(-100%);
      box-shadow: 8px 0 30px rgba(53, 41, 31, 0.12);
    }
    .nav-links.open { transform: translateX(0); }
    .nav-links a { font-size: 1.05rem; }
    .nav-links .lang-switch { font-size: 0.85rem; }
    .nav-cta { margin-top: 0.5rem; }
  }
</style>
