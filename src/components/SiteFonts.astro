---
interface Props {
  lang: "fr" | "ar";
}
const { lang } = Astro.props;
const isAr = lang === "ar";
const href = isAr
  ? "https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@300;400;500;700&family=Aref+Ruqaa:wght@400;700&family=Fraunces:ital,opsz,wght@1,9..144,400;1,9..144,500&display=swap"
  : "https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500;1,9..144,600&family=Work+Sans:wght@300;400;500;600&family=Aref+Ruqaa:wght@400;700&display=swap";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link {href} rel="stylesheet" />
