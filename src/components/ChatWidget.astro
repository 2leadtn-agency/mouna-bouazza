---
interface Props {
  lang: "fr" | "ar";
}
const { lang } = Astro.props;
const isAr = lang === "ar";
const label = isAr ? "لديكِ سؤال؟" : "Une question ?";
const ariaLabel = isAr ? "تواصلي معنا عبر واتساب" : "Discuter avec nous sur WhatsApp";
---

<div class="chat-widget">
  <span class="chat-bubble reveal">{label}</span>
  <a href="https://wa.me/21622959441" target="_blank" rel="noopener" class="chat-fab reveal" aria-label={ariaLabel}>
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>
    </svg>
  </a>
</div>

<style>
  .chat-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .chat-bubble {
    background: var(--paper);
    color: var(--espresso);
    font-family: "Work Sans", "Tajawal", sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    box-shadow: 0 8px 22px rgba(53, 41, 31, 0.16);
    white-space: nowrap;
    transform: translateX(0) translateY(0);
  }
  .chat-fab {
    width: 3.4rem;
    height: 3.4rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 26px rgba(189, 108, 68, 0.4);
    position: relative;
    text-decoration: none;
    transition: transform 0.4s var(--ease-soft), background 0.35s ease;
  }
  .chat-fab:hover {
    transform: translateY(-3px) scale(1.06);
    background: var(--terracotta-dark);
  }
  .chat-fab .icon {
    width: 1.6rem;
    height: 1.6rem;
    stroke-width: 1.8;
  }
  .chat-fab::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--terracotta);
    animation: chat-pulse 2.8s ease-out infinite;
  }
  @keyframes chat-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    100% { transform: scale(1.65); opacity: 0; }
  }

  @media (max-width: 600px) {
    .chat-widget { bottom: 1.1rem; right: 1.1rem; gap: 0.5rem; }
    .chat-bubble { font-size: 0.76rem; padding: 0.48rem 0.85rem; }
    .chat-fab { width: 3rem; height: 3rem; }
    .chat-fab .icon { width: 1.4rem; height: 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-fab::after { animation: none; }
  }
</style>
