---
interface Props {
  lang: "fr" | "ar";
}
const { lang } = Astro.props;
const isAr = lang === "ar";
const label = isAr ? "لديكِ سؤال؟" : "Une question ?";
const chatAriaLabel = isAr ? "تواصلي معنا" : "Discuter avec nous";
const waAriaLabel = isAr ? "راسلينا على واتساب" : "Nous écrire sur WhatsApp";
---

<div class="chat-widget">
  <a href="https://wa.me/21622959441" target="_blank" rel="noopener" class="chat-fab chat-fab-wa" aria-label={waAriaLabel}>
    <!-- recognizable WhatsApp-style mark: brand green + handset glyph -->
    <svg class="chat-fab-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"
        fill="currentColor" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round"
      />
    </svg>
  </a>

  <div class="chat-row">
    <span class="chat-bubble">{label}</span>
    <a href="https://wa.me/21622959441" target="_blank" rel="noopener" class="chat-fab chat-fab-ask" aria-label={chatAriaLabel}>
      <span class="chat-fab-ring"></span>
      <!-- custom mark: a speech bubble carrying a small sparkle — the site's "ask us" signature -->
      <svg class="chat-fab-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"
          stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
        />
        <path
          d="M17 4.2 17.55 5.85 19.2 6.4 17.55 6.95 17 8.6 16.45 6.95 14.8 6.4 16.45 5.85Z"
          fill="currentColor" stroke="currentColor" stroke-width="0.6" stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>
</div>

<style>
  .chat-widget {
    position: fixed;
    bottom: calc(1.6rem + env(safe-area-inset-bottom, 0px));
    right: calc(1.6rem + env(safe-area-inset-right, 0px));
    z-index: 120;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.85rem;
    pointer-events: none;
    /* keep icon-right / label-left order consistent on the Arabic (RTL) page too */
    direction: ltr;
  }
  .chat-widget > * {
    pointer-events: auto;
  }
  .chat-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .chat-bubble {
    background: var(--paper);
    color: var(--espresso);
    font-family: "Work Sans", "Tajawal", sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    box-shadow: 0 8px 22px rgba(53, 41, 31, 0.16);
    white-space: nowrap;
    opacity: 0;
    animation: chat-in 0.6s var(--ease-soft) 1.1s forwards;
  }
  .chat-fab {
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    opacity: 0;
    color: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-decoration: none;
    transition: transform 0.4s var(--ease-soft), box-shadow 0.4s var(--ease-soft);
  }
  .chat-fab-ask {
    background: linear-gradient(155deg, var(--terracotta), var(--terracotta-dark));
    box-shadow: 0 10px 26px rgba(189, 108, 68, 0.42);
    animation: chat-in 0.6s var(--ease-soft) 0.9s forwards, chat-bob 3.6s ease-in-out 1.6s infinite;
  }
  .chat-fab-ask:hover {
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 16px 34px rgba(189, 108, 68, 0.5);
    animation-play-state: paused;
  }
  .chat-fab-wa {
    width: 3rem;
    height: 3rem;
    background: linear-gradient(155deg, #2fd66b, #22b358);
    box-shadow: 0 10px 24px rgba(34, 179, 88, 0.4);
    animation: chat-in 0.6s var(--ease-soft) 0.7s forwards;
  }
  .chat-fab-wa:hover {
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 16px 30px rgba(34, 179, 88, 0.48);
  }
  .chat-fab-icon {
    width: 1.7rem;
    height: 1.7rem;
  }
  .chat-fab-wa .chat-fab-icon {
    width: 1.4rem;
    height: 1.4rem;
  }
  .chat-fab-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--terracotta);
    animation: chat-pulse 2.8s ease-out infinite;
    pointer-events: none;
  }
  @keyframes chat-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    100% { transform: scale(1.65); opacity: 0; }
  }
  @keyframes chat-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  @keyframes chat-in {
    from { opacity: 0; transform: translateY(14px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (max-width: 600px) {
    .chat-widget {
      bottom: calc(1.15rem + env(safe-area-inset-bottom, 0px));
      right: calc(1.15rem + env(safe-area-inset-right, 0px));
      gap: 0.65rem;
    }
    .chat-row { gap: 0.5rem; }
    .chat-bubble { font-size: 0.76rem; padding: 0.48rem 0.85rem; }
    .chat-fab-ask { width: 3.1rem; height: 3.1rem; }
    .chat-fab-ask .chat-fab-icon { width: 1.45rem; height: 1.45rem; }
    .chat-fab-wa { width: 2.7rem; height: 2.7rem; }
    .chat-fab-wa .chat-fab-icon { width: 1.25rem; height: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-fab-ask, .chat-fab-wa, .chat-bubble { animation: none; opacity: 1; }
    .chat-fab-ring { animation: none; opacity: 0; }
  }
</style>
