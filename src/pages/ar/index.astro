---
import "../../styles/global.css";

const icon = (name: string) => {
  const icons: Record<string, string> = {
    leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',
    lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
    "heart-handshake": '<path d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762"/>',
    phone: '<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/>',
    mail: '<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/>',
    "map-pin": '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
    clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    "message-circle": '<path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>',
    menu: '<path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>',
    x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
    "arrow-down": '<path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>',
    "arrow-right": '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
    droplets: '<path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>',
    waves: '<path d="M2 12q2.5 2 5 0t5 0 5 0 5 0"/><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0"/><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0"/>',
    flame: '<path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"/>',
    languages: '<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>',
    quote: '<path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/>',
  };
  return icons[name] ?? "";
};
---
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="نور المنى بوعزة: عناية تكاملية للمرأة، تجمع بين المساج، الماديروثيرابي، التصريف اللمفاوي والحجامة، في فضاء خاص يحفظ خصوصيتكِ." />
  <title>نور المنى بوعزة — عناية تكاملية للمرأة</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23bd6c44'/%3E%3Ctext x='16' y='22' font-size='18' text-anchor='middle' fill='%23fbf8f2' font-family='Georgia,serif' font-style='italic'%3EM%3C/text%3E%3C/svg%3E" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@300;400;500;700&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ============ NAV ============ -->
  <header class="site-nav" id="siteNav">
    <div class="container nav-inner">
      <a href="#top" class="wordmark">نور المنى بوعزة</a>

      <nav class="nav-links" id="navLinks">
        <a href="#top">الرئيسية</a>
        <a href="#a-propos">من أنا</a>
        <a href="#soins">جلسات العناية</a>
        <a href="#experience">تجربتكِ</a>
        <a href="#espace">الفضاء</a>
        <a href="/" class="lang-switch" hreflang="fr" lang="fr">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("languages")} />
          Français
        </a>
        <a href="#contact" class="nav-cta">احجزي موعدكِ</a>
      </nav>

      <button class="nav-toggle" id="navToggle" aria-label="فتح القائمة">
        <svg class="icon" id="navToggleIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("menu")} />
      </button>
    </div>
  </header>

  <main id="top">

    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow reveal">نور المنى بوعزة · عناية تكاملية للمرأة</p>
        <p class="hero-accent reveal reveal-delay-1">أهلًا بكِ</p>
        <h1 class="hero-title reveal reveal-delay-1">مساحة لكِ وحدكِ،<br />لتعودي إلى نفسكِ.</h1>
        <p class="hero-sub reveal reveal-delay-2">
          جلسات عناية تكاملية مخصّصة للنساء، تجمع بين المساج، الماديروثيرابي،
          التصريف اللمفاوي والحجامة، داخل فضاء هادئ يحفظ خصوصيتكِ ويمنحكِ
          الوقت والاهتمام اللذين تستحقينهما.
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="#contact" class="btn btn-primary">احجزي لحظتكِ</a>
          <a href="#soins" class="btn-text">
            اكتشفي جلسات العناية
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("arrow-down")} />
          </a>
        </div>
      </div>
      <div class="hero-image reveal reveal-img">
        <img src="/images/hero-massage-pierres-chaudes-bougies.jpg" alt="جلسة تدليك بالحجارة الساخنة في أجواء شموع دافئة" />
      </div>
    </section>

    <!-- ============ SIGNATURE FULL-BLEED MOMENT ============ -->
    <section class="signature">
      <img src="/images/salle-de-soin-ambiance-cocon.jpg" alt="غرفة علاج دافئة وهادئة، طاولة تدليك وإضاءة ناعمة" class="signature-img" />
      <div class="signature-overlay"></div>
      <p class="signature-quote reveal">هنا، يهدأ كل شيء.</p>
      <p class="signature-text reveal reveal-delay-1">
        يخفّ ضجيج الخارج، يسترخي الجسد، وتجدين أخيرًا مساحة تتنفّسين فيها على مهل.
      </p>
    </section>

    <!-- ============ ABOUT / PHILOSOPHY ============ -->
    <section class="about container" id="a-propos">
      <div class="about-image reveal reveal-img">
        <img src="/images/mains-bienveillantes-soin-jambe.jpg" alt="أيادٍ حانية تقدّم عناية ملفوفة بمنشفة بيضاء" />
      </div>
      <div class="about-text">
        <p class="eyebrow reveal">عنايتكِ تبدأ بالإنصات إليكِ</p>
        <h2 class="reveal reveal-delay-1">لأن كل جسد يحمل قصة مختلفة</h2>
        <p class="reveal reveal-delay-2">
          لا تبدأ الجلسة بحركات محفوظة أو برنامج واحد يناسب الجميع، بل تبدأ
          بكِ أنتِ: بما تشعرين به، بما يحتاجه جسدكِ، وبالراحة التي تبحثين عنها.
        </p>
        <p class="reveal reveal-delay-2">
          تقدّم نور المنى بوعزة جلسات عناية تكاملية تجمع بين الممارسات
          التقليدية وتقنيات العناية الحديثة، ضمن مقاربة إنسانية تراعي
          خصوصية كل امرأة وإيقاعها.
        </p>
        <p class="reveal reveal-delay-2">
          هنا، لن تشعري بأنكِ رقم أو موعد عابر. ستجدين إنصاتًا حقيقيًا،
          عناية على مهل، وفضاءً صُمّم لتشعري فيه بالأمان والطمأنينة.
        </p>
        <p class="about-signature reveal reveal-delay-3">— نور المنى بوعزة</p>
      </div>
    </section>

    <!-- ============ SERVICES ============ -->
    <section class="soins" id="soins">
      <div class="container soins-head">
        <p class="eyebrow reveal">عناية تستمع إلى جسدكِ</p>
        <h2 class="reveal reveal-delay-1">اختاري اللحظة التي يحتاجها جسدكِ اليوم</h2>
        <p class="section-intro reveal reveal-delay-2">
          ليست كل الأيام متشابهة، وليست كل الأجساد بحاجة إلى العناية نفسها.
          لذلك تُختار كل جلسة وفق احتياجاتكِ، إحساسكِ والنتيجة التي تبحثين عنها.
        </p>
      </div>

      <div class="soin-row" data-side="left">
        <div class="container soin-grid">
          <div class="soin-media reveal reveal-img">
            <img src="/images/service-madero-therapie-outils-bois.jpg" alt="أدوات خشبية تُستخدم في جلسة الماديروثيرابي" />
          </div>
          <div class="soin-content reveal reveal-delay-1">
            <span class="soin-num">01</span>
            <svg class="icon soin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("waves")} />
            <h3>الماديروثيرابي ونحت القوام</h3>
            <p>عناية تعتمد على أدوات خشبية وحركات مدروسة تستهدف مناطق محددة من الجسم، وتمنحكِ إحساسًا بالخفة والحيوية مع عناية خاصة بمظهر القوام والبشرة.</p>
            <p>جلسة للمرأة التي ترغب في الاعتناء بجسدها، استعادة نشاطها والشعور براحة أكبر في تفاصيله.</p>
          </div>
        </div>
      </div>

      <div class="soin-row" data-side="right">
        <div class="container soin-grid">
          <div class="soin-content reveal reveal-delay-1">
            <span class="soin-num">02</span>
            <svg class="icon soin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("heart-handshake")} />
            <h3>المساج والاسترخاء</h3>
            <p>حين يحمل الجسد أكثر مما يستطيع، تصبح الراحة حاجة وليست رفاهية.</p>
            <p>جلسات مساج استرخائية أو موجهة، تُكيّف حركاتها ووتيرتها حسب احتياجاتكِ، لمساعدتكِ على تخفيف الإحساس بالتعب واستعادة لحظة من الهدوء العميق.</p>
          </div>
          <div class="soin-media reveal reveal-img">
            <img src="/images/service-massages-mains-dos.jpg" alt="تدليك للظهر بأيادٍ خبيرة ولطيفة" />
          </div>
        </div>
      </div>

      <div class="soin-row" data-side="left">
        <div class="container soin-grid">
          <div class="soin-media reveal reveal-img">
            <img src="/images/service-drainage-lymphatique-pied.jpg" alt="تصريف لمفاوي لطيف، أيادٍ موضوعة على القدم" />
          </div>
          <div class="soin-content reveal reveal-delay-1">
            <span class="soin-num">03</span>
            <svg class="icon soin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("droplets")} />
            <h3>التصريف اللمفاوي</h3>
            <p>جلسة تتميز بحركات لطيفة، منتظمة ومدروسة، تمنح الجسم إحساسًا بالخفة والراحة، خاصة عند الشعور بالثقل أو الانتفاخ.</p>
            <p>عناية هادئة لا تستعجل جسدكِ، بل ترافقه بلطف وعلى إيقاعه الخاص.</p>
          </div>
        </div>
      </div>

      <div class="soin-row" data-side="right">
        <div class="container soin-grid">
          <div class="soin-content reveal reveal-delay-1">
            <span class="soin-num">04</span>
            <svg class="icon soin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("flame")} />
            <h3>الحجامة</h3>
            <p>ممارسة تقليدية من ممارسات الطب التكميلي، تُقدَّم بعناية ودقة داخل أجواء هادئة تحترم راحتكِ وخصوصيتكِ.</p>
            <p>تبدأ كل جلسة بالاستماع إليكِ وفهم احتياجاتكِ، حتى تكون التجربة أكثر اطمئنانًا وملاءمة لكِ.</p>
          </div>
          <div class="soin-media reveal reveal-img">
            <img src="/images/service-hijama-bougie-plantes.jpg" alt="شمعة وقارورة عطارة وأزهار مجففة، أجواء مهدئة" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ REASSURANCE / EXPERIENCE ============ -->
    <section class="reassurance container" id="experience">
      <p class="eyebrow reveal">أكثر من مجرد جلسة عناية</p>
      <h2 class="reveal reveal-delay-1">كل ما حولكِ يقول: أنتِ في مكانكِ</h2>
      <p class="section-intro reveal reveal-delay-2">
        منذ لحظة دخولكِ، ستشعرين بأن هذا الفضاء لم يُصمّم فقط لتقديم جلسة، بل
        ليمنحكِ تجربة كاملة من الراحة، الخصوصية والاهتمام.
      </p>

      <ul class="reassurance-list">
        <li class="reveal reveal-delay-1">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("users")} />
          <div>
            <h4>فضاء مخصّص للنساء</h4>
            <p>مكان نسائي خالص، صُمّم لتكوني فيه مرتاحة، مطمئنة وعلى طبيعتكِ.</p>
          </div>
        </li>
        <li class="reveal reveal-delay-2">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("lock")} />
          <div>
            <h4>خصوصيتكِ أولوية</h4>
            <p>كل جلسة تتم في أجواء خاصة وهادئة، بعيدًا عن الإزعاج ونظرات الآخرين.</p>
          </div>
        </li>
        <li class="reveal reveal-delay-2">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("leaf")} />
          <div>
            <h4>جلسة على إيقاعكِ</h4>
            <p>لا استعجال، ولا تطبيق آلي للحركات. تُكيّف الجلسة مع حالتكِ واحتياجاتكِ في ذلك اليوم.</p>
          </div>
        </li>
        <li class="reveal reveal-delay-3">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("heart-handshake")} />
          <div>
            <h4>الإنصات قبل العناية</h4>
            <p>نمنحكِ الوقت لتعبّري عما تشعرين به وما تنتظرينه من الجلسة، لأن العناية الحقيقية تبدأ عندما تشعرين أنكِ مسموعة.</p>
          </div>
        </li>
      </ul>
    </section>

    <!-- ============ PROMISE / BRAND MESSAGE ============ -->
    <section class="promise">
      <div class="container">
        <svg class="promise-quote-icon reveal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={icon("quote")} />
        <p class="eyebrow eyebrow-on-sage reveal">وعدنا لكِ</p>
        <p class="promise-quote reveal reveal-delay-1">لا نراكِ موعدًا في جدول.</p>
        <p class="promise-text reveal reveal-delay-2">
          نراكِ امرأة اختارت أن تتوقف قليلًا، أن تُصغي إلى جسدها، وأن تمنح
          نفسها العناية التي كثيرًا ما تؤجلها.
        </p>
        <p class="promise-text reveal reveal-delay-2">
          هنا، وقتكِ لكِ.<br />
          وراحتكِ تستحق كل اهتمامنا.
        </p>
        <p class="promise-sign reveal reveal-delay-3">— نور المنى بوعزة</p>
      </div>
    </section>

    <!-- ============ GALLERY / ESPACE ============ -->
    <section class="galerie container" id="espace">
      <p class="eyebrow reveal">مساحتكِ الخاصة</p>
      <h2 class="reveal reveal-delay-1">مكان يخفّ فيه الضجيج، وتبدأ الراحة من أول خطوة</h2>
      <p class="section-intro reveal reveal-delay-2">
        إضاءة دافئة، تفاصيل هادئة وأجواء نسائية حميمية صُمّمت لتشعري بالطمأنينة منذ دخولكِ.
      </p>
      <p class="section-intro reveal reveal-delay-2">
        بعيدًا عن برودة العيادات وضغط الحياة اليومية، تجدين مساحة تحتضن راحتكِ وتمنحكِ لحظة حقيقية مع نفسكِ.
      </p>

      <div class="galerie-grid">
        <div class="g-item g-tall reveal reveal-img">
          <img src="/images/ambiance-bassin-pieds-fleurs.jpg" alt="حوض للقدمين مزيّن بالزهور، طقس للعناية بالذات" />
        </div>
        <div class="g-item g-wide reveal reveal-img reveal-delay-1">
          <img src="/images/ambiance-cabine-soin-boheme.jpg" alt="غرفة علاج بأجواء دافئة ونباتية" />
        </div>
        <div class="g-item reveal reveal-img reveal-delay-1">
          <img src="/images/ambiance-pierres-chaudes-etagere.jpg" alt="حجارة ساخنة موضوعة على الظهر، أجواء لطيفة" />
        </div>
        <div class="g-item reveal reveal-img reveal-delay-2">
          <img src="/images/ambiance-etagere-huiles-bois.jpg" alt="رف خشبي وزيوت أساسية، ركن للعطارة" />
        </div>
      </div>
    </section>

    <!-- ============ CONTACT / BOOKING ============ -->
    <section class="contact" id="contact">
      <div class="container contact-grid">
        <div class="contact-text reveal">
          <p class="eyebrow eyebrow-on-sage">موعدكِ مع نفسكِ</p>
          <h2>هذه المرة، اختاري راحتكِ</h2>
          <p class="contact-lead-line">
            لا تنتظري حتى يتراكم التعب أو يصبح جسدكِ آخر ما تفكرين فيه.
          </p>
          <p class="contact-lead-line">
            امنحي نفسكِ لحظة تتوقفين فيها، تتنفّسين، وتستعيدين إحساسكِ بالهدوء والخفة.
          </p>
          <p class="contact-lead">
            نستقبلكِ بالموعد المسبق من الأحد إلى الخميس. يمكنكِ التواصل معنا
